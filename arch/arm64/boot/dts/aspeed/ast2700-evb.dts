&i2c12 {
	status = "okay";
};

&i2c13 {
	status = "okay";
};
#endif

#if 0
&ehci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&uhci0 {
	status = "okay";
	memory-region = <&uhci0_reserved>;
