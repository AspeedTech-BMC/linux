#if 0
&xhci0 {
	status = "okay";
};

&xhci1 {
	status = "okay";
};
#endif

&vhuba0 {
	status = "okay";
	pinctrl-0 = <&pinctrl_usb2ahpd0_default>;
};

&usb3ahp {
	status = "okay";
	pinctrl-0 = <&pinctrl_usb3axhp_default &pinctrl_usb2axhp_default>;
};

&usb3bhp {
	status = "okay";
};

&uphy2b {
	status = "okay";
};

&vhubb1 {
	status = "okay";
};

&vhubc {
	status = "okay";
