&ehci3 {
	status = "okay";
};

&uhci1 {
	status = "okay";
	memory-region = <&uhci1_reserved>;
};

&mctp0 {
	status = "okay";
	memory-region = <&mctp0_reserved>;
};

&mctp1 {
	status = "okay";
	memory-region = <&mctp1_reserved>;
};

&mctp2 {
	status = "okay";
	memory-region = <&mctp2_reserved>;
};

