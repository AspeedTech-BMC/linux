	initial-role = "primary";
	status = "okay";
};

&ltpi0_i3c10 {
	initial-role = "target";
	pid = <0x000007ec 0x06000000>;
	dcr = /bits/ 8 <0xcc>;
	status = "okay";
};

&ltpi0_i3c11 {
	initial-role = "primary";
	status = "okay";
};

&ltpi0_i3c12 {
	initial-role = "target";
	pid = <0x000007ec 0x06000000>;
	dcr = /bits/ 8 <0xcc>;
	status = "okay";
};

&ltpi0_i3c13 {
	initial-role = "primary";
	status = "okay";
};

&ltpi0_i3c14 {
	initial-role = "target";
